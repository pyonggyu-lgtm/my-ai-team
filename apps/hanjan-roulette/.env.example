# 한잔메뉴룰렛 서버 환경 변수 견본 (값은 비워 둠)
# 서버에서: cp .env.example .env && chmod 600 .env && nano .env
# PM2가 node --env-file=.env 로 읽는다 (deploy/ecosystem.config.js).

# 앱 서버 포트. Nginx proxy_pass 포트와 같아야 한다. 예: 3000
PORT=

# 바인딩 주소. 외부에 직접 열지 않도록 127.0.0.1 권장. 예: 127.0.0.1
HOST=

# SQLite DB 파일 경로. 예: /srv/hanjan-data/hanjan.db
DB_PATH=
